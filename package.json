{
  "name": "protocolo-eudaimonia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore --project demo-eudaimonia \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify:refs": "node scripts/verify-references.mjs src/domain referencias-informe.json",
    "approve": "APPROVE_CONTENT=1 vitest run src/domain/approval.test.ts"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "motion": "^12.23.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
