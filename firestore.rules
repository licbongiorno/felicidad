rules_version = '2';

// Principios:
//  1. Cada usuario es dueño exclusivo de su árbol users/{uid}.
//  2. Un clínico sólo LEE datos de un paciente con vínculo activo y consentido (careLinks).
//  3. Los registros clínicos son de sólo-anexión: se crean y se pueden borrar (derecho de
//     supresión), pero no se reescriben. El check-in diario es la única excepción (editable el mismo día).
//  4. Validación de esquema en el servidor: claves permitidas, tipos y rangos.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function hasActiveCareLink(patientId) {
      let linkId = request.auth.uid + '_' + patientId;
      return signedIn()
        && exists(/databases/$(database)/documents/careLinks/$(linkId))
        && get(/databases/$(database)/documents/careLinks/$(linkId)).data.status == 'active';
    }

    function canRead(uid) { return isOwner(uid) || hasActiveCareLink(uid); }

    // ---- diario: claves permitidas por plantilla y límites de longitud
    function shortText(v, k) { return !(k in v) || (v[k] is string && v[k].size() <= 280); }
    function longText(v, k) { return !(k in v) || (v[k] is string && v[k].size() <= 8000); }
    function score(v, k) { return !(k in v) || (v[k] is int && v[k] >= 0 && v[k] <= 10); }

    function i(d, k, max) { return inRange(d.items[k], 0, max); }
    // DERS-16: respuestas de 1 a 5.
    function d1(d, k) { return inRange(d.items[k], 1, 5); }
    function validAssessment(d) {
      return (d.instrument == 'who5' && d.items.size() == 5
          && i(d, 0, 5) && i(d, 1, 5) && i(d, 2, 5) && i(d, 3, 5) && i(d, 4, 5)
          && d.score == 4 * (d.items[0] + d.items[1] + d.items[2] + d.items[3] + d.items[4]))
        || (d.instrument == 'gad7' && d.items.size() == 7
          && i(d, 0, 3) && i(d, 1, 3) && i(d, 2, 3) && i(d, 3, 3) && i(d, 4, 3) && i(d, 5, 3) && i(d, 6, 3)
          && d.score == d.items[0] + d.items[1] + d.items[2] + d.items[3] + d.items[4] + d.items[5] + d.items[6])
        || (d.instrument == 'phq9' && d.items.size() == 9
          && i(d, 0, 3) && i(d, 1, 3) && i(d, 2, 3) && i(d, 3, 3) && i(d, 4, 3) && i(d, 5, 3) && i(d, 6, 3) && i(d, 7, 3) && i(d, 8, 3)
          && d.score == d.items[0] + d.items[1] + d.items[2] + d.items[3] + d.items[4] + d.items[5] + d.items[6] + d.items[7] + d.items[8])
        || (d.instrument == 'ders16' && d.items.size() == 16
          && d1(d, 0) && d1(d, 1) && d1(d, 2) && d1(d, 3) && d1(d, 4) && d1(d, 5) && d1(d, 6) && d1(d, 7)
          && d1(d, 8) && d1(d, 9) && d1(d, 10) && d1(d, 11) && d1(d, 12) && d1(d, 13) && d1(d, 14) && d1(d, 15)
          && d.score == d.items[0] + d.items[1] + d.items[2] + d.items[3] + d.items[4] + d.items[5] + d.items[6] + d.items[7]
             + d.items[8] + d.items[9] + d.items[10] + d.items[11] + d.items[12] + d.items[13] + d.items[14] + d.items[15])
        || (d.instrument == 'isi' && d.items.size() == 7
          && i(d, 0, 4) && i(d, 1, 4) && i(d, 2, 4) && i(d, 3, 4) && i(d, 4, 4) && i(d, 5, 4) && i(d, 6, 4)
          && d.score == d.items[0] + d.items[1] + d.items[2] + d.items[3] + d.items[4] + d.items[5] + d.items[6])
        // PSS-10: los ítems 4, 5, 7 y 8 (índices 3, 4, 6 y 7) se puntúan al revés (4 − respuesta).
        || (d.instrument == 'pss10' && d.items.size() == 10
          && i(d, 0, 4) && i(d, 1, 4) && i(d, 2, 4) && i(d, 3, 4) && i(d, 4, 4) && i(d, 5, 4) && i(d, 6, 4) && i(d, 7, 4) && i(d, 8, 4) && i(d, 9, 4)
          && d.score == d.items[0] + d.items[1] + d.items[2] + (4 - d.items[3]) + (4 - d.items[4]) + d.items[5]
             + (4 - d.items[6]) + (4 - d.items[7]) + d.items[8] + d.items[9]);
    }

    function validJournalValues(type, v) {
      return (type == 'tres-cosas'
          && v.keys().hasOnly(['cosa1', 'porque1', 'cosa2', 'porque2', 'cosa3', 'porque3'])
          && shortText(v, 'cosa1') && shortText(v, 'porque1') && shortText(v, 'cosa2')
          && shortText(v, 'porque2') && shortText(v, 'cosa3') && shortText(v, 'porque3'))
        || (type == 'defusion'
          && v.keys().hasOnly(['situacion', 'pensamiento', 'credibilidadPre', 'defusion', 'credibilidadPost', 'accion'])
          && shortText(v, 'situacion') && shortText(v, 'pensamiento') && shortText(v, 'defusion') && shortText(v, 'accion')
          && score(v, 'credibilidadPre') && score(v, 'credibilidadPost'))
        || (type == 'saboreo'
          && v.keys().hasOnly(['momento', 'sentidos', 'emocion', 'compartir'])
          && shortText(v, 'momento') && longText(v, 'sentidos') && shortText(v, 'emocion') && shortText(v, 'compartir'))
        || (type == 'valores'
          && v.keys().hasOnly(['dominio', 'valor', 'accion', 'obstaculo', 'plan'])
          && shortText(v, 'dominio') && shortText(v, 'valor') && shortText(v, 'accion')
          && shortText(v, 'obstaculo') && shortText(v, 'plan'))
        || (type == 'escritura-expresiva'
          && v.keys().hasOnly(['tema', 'texto', 'malestarPost'])
          && shortText(v, 'tema') && longText(v, 'texto') && score(v, 'malestarPost'))
        || (type == 'carta-gratitud'
          && v.keys().hasOnly(['destinatario', 'carta', 'entrega'])
          && shortText(v, 'destinatario') && longText(v, 'carta') && shortText(v, 'entrega'))
        || (type == 'mejor-yo'
          && v.keys().hasOnly(['horizonte', 'texto', 'paso'])
          && shortText(v, 'horizonte') && longText(v, 'texto') && shortText(v, 'paso'))
        || (type == 'reestructuracion'
          && v.keys().hasOnly(['situacion', 'emocion', 'intensidadPre', 'pensamiento', 'trampa', 'aFavor', 'enContra', 'alternativo', 'intensidadPost'])
          && shortText(v, 'situacion') && shortText(v, 'emocion') && score(v, 'intensidadPre') && shortText(v, 'pensamiento') && shortText(v, 'trampa')
          && shortText(v, 'aFavor') && shortText(v, 'enContra') && shortText(v, 'alternativo') && score(v, 'intensidadPost'))
        || (type == 'carta-compasiva'
          && v.keys().hasOnly(['dificultad', 'carta', 'frase'])
          && shortText(v, 'dificultad') && longText(v, 'carta') && shortText(v, 'frase'))
        || (type == 'activacion'
          && v.keys().hasOnly(['actividad', 'prediccion', 'placer', 'logro', 'nota'])
          && shortText(v, 'actividad') && score(v, 'prediccion') && score(v, 'placer') && score(v, 'logro') && shortText(v, 'nota'))
        || (type == 'preocupacion'
          && v.keys().hasOnly(['preocupacion', 'probabilidad', 'controlable', 'paso', 'soltar'])
          && shortText(v, 'preocupacion') && score(v, 'probabilidad') && shortText(v, 'controlable') && shortText(v, 'paso') && shortText(v, 'soltar'))
        || (type == 'perdon'
          && v.keys().hasOnly(['ofensa', 'empatia', 'regalo', 'compromiso'])
          && shortText(v, 'ofensa') && longText(v, 'empatia') && shortText(v, 'regalo') && shortText(v, 'compromiso'))
        || (type == 'intencion'
          && v.keys().hasOnly(['valor', 'si', 'entonces', 'obstaculo'])
          && shortText(v, 'valor') && shortText(v, 'si') && shortText(v, 'entonces') && shortText(v, 'obstaculo'))
        || (type == 'resolucion-problemas'
          && v.keys().hasOnly(['problema', 'objetivo', 'opciones', 'elegida', 'plan', 'revision'])
          && shortText(v, 'problema') && shortText(v, 'objetivo') && longText(v, 'opciones') && shortText(v, 'elegida')
          && shortText(v, 'plan') && shortText(v, 'revision'))
        || (type == 'diario-sueno'
          && v.keys().hasOnly(['acostarse', 'latencia', 'despertares', 'levantarse', 'calidad', 'calidadTexto'])
          && shortText(v, 'acostarse') && shortText(v, 'latencia') && shortText(v, 'despertares') && shortText(v, 'levantarse')
          && score(v, 'calidad') && shortText(v, 'calidadTexto'))
        || (type == 'experimento'
          && v.keys().hasOnly(['creencia', 'credibilidadPre', 'experimento', 'prediccion', 'resultado', 'aprendizaje', 'credibilidadPost'])
          && shortText(v, 'creencia') && score(v, 'credibilidadPre') && shortText(v, 'experimento') && shortText(v, 'prediccion')
          && shortText(v, 'resultado') && shortText(v, 'aprendizaje') && score(v, 'credibilidadPost'))
        || (type == 'escalera-exposicion'
          && v.keys().hasOnly(['miedo', 'escalones', 'escalon', 'malestarPrevisto', 'malestarReal', 'aprendizaje'])
          && shortText(v, 'miedo') && longText(v, 'escalones') && shortText(v, 'escalon') && score(v, 'malestarPrevisto')
          && score(v, 'malestarReal') && shortText(v, 'aprendizaje'))
        || (type == 'plan-seguridad'
          && v.keys().hasOnly(['senales', 'estrategias', 'distraccion', 'ayuda', 'profesionales', 'entorno', 'razones'])
          && longText(v, 'senales') && longText(v, 'estrategias') && longText(v, 'distraccion') && longText(v, 'ayuda')
          && longText(v, 'profesionales') && longText(v, 'entorno') && longText(v, 'razones'))
        || (type == 'conversacion'
          && v.keys().hasOnly(['con', 'hechos', 'siento', 'peticion', 'gana', 'negociable', 'resultado'])
          && shortText(v, 'con') && shortText(v, 'hechos') && shortText(v, 'siento') && shortText(v, 'peticion')
          && shortText(v, 'gana') && shortText(v, 'negociable') && shortText(v, 'resultado'))
        || (type == 'tarjeta-diaria'
          && v.keys().hasOnly(['resumen', 'tristeza', 'miedo', 'ira', 'verguenza', 'alegria', 'impulso', 'impulsoIntensidad', 'conducta', 'habilidades', 'utilidad'])
          && shortText(v, 'resumen') && score(v, 'tristeza') && score(v, 'miedo') && score(v, 'ira') && score(v, 'verguenza')
          && score(v, 'alegria') && shortText(v, 'impulso') && score(v, 'impulsoIntensidad') && shortText(v, 'conducta')
          && shortText(v, 'habilidades') && score(v, 'utilidad'))
        || (type == 'analisis-cadena'
          && v.keys().hasOnly(['conducta', 'vulnerabilidad', 'disparador', 'eslabones', 'consecuencias', 'alternativas', 'prevencion', 'reparacion'])
          && shortText(v, 'conducta') && shortText(v, 'vulnerabilidad') && shortText(v, 'disparador') && longText(v, 'eslabones')
          && shortText(v, 'consecuencias') && longText(v, 'alternativas') && shortText(v, 'prevencion') && shortText(v, 'reparacion'))
        || (type == 'caja-herramientas'
          && v.keys().hasOnly(['verdePracticas', 'verdePropias', 'amarilloSenales', 'amarilloPracticas', 'amarilloPropias',
               'rojoSenales', 'rojoPracticas', 'rojoPropias', 'personas', 'frases'])
          && shortText(v, 'verdePracticas') && longText(v, 'verdePropias') && longText(v, 'amarilloSenales')
          && shortText(v, 'amarilloPracticas') && longText(v, 'amarilloPropias') && longText(v, 'rojoSenales')
          && shortText(v, 'rojoPracticas') && longText(v, 'rojoPropias') && longText(v, 'personas') && longText(v, 'frases'))
        || (type == 'mis-roles'
          && v.keys().hasOnly(['situacion', 'rol', 'desdeCuando', 'gano', 'cuesta', 'distinto'])
          && shortText(v, 'situacion') && shortText(v, 'rol') && shortText(v, 'desdeCuando') && shortText(v, 'gano')
          && shortText(v, 'cuesta') && shortText(v, 'distinto'))
        || (type == 'necesidades'
          && v.keys().hasOnly(['vinculo', 'autonomia', 'expresion', 'juego', 'limites', 'masNecesito', 'paso'])
          && score(v, 'vinculo') && score(v, 'autonomia') && score(v, 'expresion') && score(v, 'juego') && score(v, 'limites')
          && shortText(v, 'masNecesito') && shortText(v, 'paso'))
        || (type == 'patron-repetido'
          && v.keys().hasOnly(['patron', 'disparador', 'siento', 'hago', 'consecuencia', 'recuerda', 'necesitaba', 'alternativa'])
          && shortText(v, 'patron') && shortText(v, 'disparador') && shortText(v, 'siento') && shortText(v, 'hago')
          && shortText(v, 'consecuencia') && shortText(v, 'recuerda') && shortText(v, 'necesitaba') && shortText(v, 'alternativa'))
        || (type == 'reflexion-carta'
          && v.keys().hasOnly(['autor', 'texto'])
          && shortText(v, 'autor') && longText(v, 'texto'));
    }

    function inRange(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function optionalScore(v) { return v == null || inRange(v, 0, 10); }
    // Zona horaria IANA opcional (p. ej. America/Argentina/Buenos_Aires).
    function validTz(d) { return !('tz' in d) || d.tz == null || (d.tz is string && d.tz.size() <= 64); }
    // Versión del contenido usado (gobernanza clínica): entero positivo opcional.
    function validVersion(d) { return !('contentVersion' in d) || d.contentVersion == null || (d.contentVersion is int && d.contentVersion >= 1); }

    // ---------------------------------------------------------------- perfil
    match /users/{uid} {
      allow read: if canRead(uid);
      allow create: if isOwner(uid)
        && request.resource.data.role == 'patient'          // el rol clínico se asigna desde backend
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'timezone', 'consent', 'createdAt']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'createdAt']);
      allow delete: if isOwner(uid);                          // derecho de supresión

      // ------------------------------------------------------------ sesiones de práctica
      match /sessions/{id} {
        allow read: if canRead(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'practiceId', 'family', 'skills', 'source', 'startedAt',
               'durationSec', 'completed', 'moodPre', 'moodPost', 'tz', 'contentVersion', 'transfer', 'createdAt'])
          && shortText(request.resource.data, 'transfer')
          && validTz(request.resource.data)
          && validVersion(request.resource.data)
          && request.resource.data.practiceId is string
          && request.resource.data.family in ['attentional', 'constructive', 'deconstructive']
          && request.resource.data.source in ['gym', 'antidote']
          && request.resource.data.skills is list && request.resource.data.skills.size() <= 3
          && request.resource.data.startedAt is timestamp
          && request.resource.data.startedAt <= request.time + duration.value(5, 'm')  // tolera desfase de reloj
          && inRange(request.resource.data.durationSec, 0, 4 * 3600)
          && request.resource.data.completed is bool
          && optionalScore(request.resource.data.moodPre)
          && optionalScore(request.resource.data.moodPost)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ antídotos
      match /afflictionLogs/{id} {
        allow read: if canRead(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'emotionId', 'antidoteId', 'intensityPre', 'intensityPost',
               'trigger', 'stabilizationUsed', 'tz', 'contentVersion', 'createdAt'])
          && validTz(request.resource.data)
          && validVersion(request.resource.data)
          && request.resource.data.emotionId in ['ira', 'envidia', 'apego', 'autocritica', 'ansiedad', 'rumiacion', 'resentimiento', 'desanimo',
               'tristeza', 'culpa', 'soledad', 'preocupacion', 'duelo', 'agobio', 'bloqueo', 'panico',
               'verguenza', 'miedo', 'celos', 'frustracion', 'vacio', 'inseguridad']
          && inRange(request.resource.data.intensityPre, 0, 10)
          && optionalScore(request.resource.data.intensityPost)
          && (request.resource.data.trigger == null
              || (request.resource.data.trigger is string && request.resource.data.trigger.size() <= 280))
          && request.resource.data.stabilizationUsed is bool
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ check-in diario (id = YYYY-MM-DD)
      match /checkins/{date} {
        allow read: if canRead(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(['date', 'mood', 'perma', 'updatedAt'])
          && inRange(request.resource.data.mood, 0, 10)
          && (request.resource.data.perma == null || request.resource.data.perma is map)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ diario (append-only)
      // `values` es un mapa de campos de la plantilla; la forma por tipo se valida en cliente
      // y aquí se acotan tipo, número de campos y tamaño total del documento.
      match /journal/{id} {
        allow read: if canRead(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'values', 'tz', 'createdAt'])
          && validTz(request.resource.data)
          && request.resource.data.type in ['tres-cosas', 'defusion', 'saboreo', 'valores',
               'escritura-expresiva', 'carta-gratitud', 'mejor-yo', 'reestructuracion', 'carta-compasiva',
               'activacion', 'preocupacion', 'perdon', 'intencion', 'resolucion-problemas', 'diario-sueno',
               'experimento', 'escalera-exposicion', 'plan-seguridad', 'conversacion', 'tarjeta-diaria',
               'analisis-cadena', 'caja-herramientas', 'mis-roles', 'necesidades', 'patron-repetido',
               'reflexion-carta']
          && request.resource.data.values is map
          && validJournalValues(request.resource.data.type, request.resource.data.values)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ preferencias personales
      // Un solo documento («personal»): objetivos, favoritas, plan semanal y preguntas para la sesión.
      match /settings/{docId} {
        allow read: if canRead(uid);
        allow write: if isOwner(uid) && docId == 'personal'
          && request.resource.data.keys().hasOnly(['goals', 'favorites', 'plan', 'questions', 'updatedAt'])
          && (!('goals' in request.resource.data) || (request.resource.data.goals is list && request.resource.data.goals.size() <= 3))
          && (!('favorites' in request.resource.data) || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 60))
          && (!('questions' in request.resource.data) || (request.resource.data.questions is list && request.resource.data.questions.size() <= 10))
          && (!('plan' in request.resource.data) || request.resource.data.plan == null
              || (request.resource.data.plan is map && request.resource.data.plan.keys().hasOnly(['week', 'practiceIds'])
                  && request.resource.data.plan.week is string && request.resource.data.plan.week.size() <= 10
                  && request.resource.data.plan.practiceIds is list && request.resource.data.plan.practiceIds.size() <= 3))
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ aplicaciones (append-only)
      // Intento de usar una habilidad en la vida cotidiana y su utilidad percibida.
      match /applications/{id} {
        allow read: if canRead(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['practiceId', 'sessionId', 'applied', 'usefulness', 'note', 'tz', 'createdAt'])
          && validTz(request.resource.data)
          && request.resource.data.practiceId is string && request.resource.data.practiceId.size() <= 64
          && (request.resource.data.sessionId == null || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 64))
          && request.resource.data.applied is bool
          && (request.resource.data.usefulness == null || request.resource.data.usefulness in ['util', 'indiferente', 'no-apropiada'])
          && (request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 280))
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ evaluaciones (append-only)
      // Instrumentos validados: número de ítems, rango de cada respuesta y coherencia del total.
      //   WHO-5: 5 ítems 0–5, puntuación = suma × 4 (0–100)
      //   GAD-7: 7 ítems 0–3, puntuación = suma (0–21)
      //   PHQ-9: 9 ítems 0–3, puntuación = suma (0–27)
      //   DERS-16: 16 ítems 1–5, puntuación = suma (16–80)
      //   ISI: 7 ítems 0–4, puntuación = suma (0–28)
      //   PSS-10: 10 ítems 0–4, puntuación = suma con 4 ítems invertidos (0–40)
      match /assessments/{id} {
        allow read: if canRead(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['instrument', 'items', 'score', 'tz', 'createdAt'])
          && validTz(request.resource.data)
          && request.resource.data.items is list
          && validAssessment(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ------------------------------------------------------------ agregados (sólo backend)
      match /stats/{doc} {
        allow read: if canRead(uid);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------- vínculo clínico
    // id = {clinicianId}_{patientId}. El clínico propone (pending); sólo el paciente activa o revoca.
    match /careLinks/{linkId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.clinicianId || request.auth.uid == resource.data.patientId);
      allow create: if signedIn()
        && request.resource.data.clinicianId == request.auth.uid
        && linkId == request.auth.uid + '_' + request.resource.data.patientId
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinician';
      allow update: if signedIn()
        && request.auth.uid == resource.data.patientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['active', 'revoked'];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
